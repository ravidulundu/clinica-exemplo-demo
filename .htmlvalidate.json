{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-unknown-elements": "off",
    "element-required-attributes": "error",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "no-inline-style": "off",
    "long-title": "off",
    "heading-level": "error",
    "input-missing-label": "error"
  }
}
